# pnpm settings for the ParleyNotes monorepo. Use pnpm (not npm) — this is a pnpm
# workspace. node-linker=hoisted keeps a flat node_modules that Vite/Next/Tauri
# tooling and native addon resolution handle most predictably in a mixed JS + Rust
# workspace. (npm will warn "Unknown project config" on this key — harmless; run
# `pnpm dev` rather than `npm run dev`.)
node-linker=hoisted
